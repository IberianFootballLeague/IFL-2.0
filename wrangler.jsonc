{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ifl-2-0-roblox-oauth-test",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/roblox/oauth/*"],
    "not_found_handling": "404-page"
  }
}
